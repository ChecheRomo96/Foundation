{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "macos_arm64",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "FOUNDATION_PLATFORM": "macos_arm64"
      }
    },
    {
      "name": "macos_x64",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "FOUNDATION_PLATFORM": "macos_x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos_arm64",
      "configurePreset": "macos_arm64",
      "configuration": "Debug"
    },
    {
      "name": "macos_x64",
      "configurePreset": "macos_x64",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "macos_arm64",
      "configurePreset": "macos_arm64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos_x64",
      "configurePreset": "macos_x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
