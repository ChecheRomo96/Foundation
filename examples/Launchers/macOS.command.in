#!/bin/sh

LAUNCHER_DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

foundation_example_count() {
    EXAMPLE_COUNT=0
    for EXAMPLE_EXECUTABLE in "$LAUNCHER_DIRECTORY"/Foundation_*; do
        [ -f "$EXAMPLE_EXECUTABLE" ] || continue
        [ -x "$EXAMPLE_EXECUTABLE" ] || continue
        EXAMPLE_COUNT=$((EXAMPLE_COUNT + 1))
    done
}

foundation_print_menu() {
    EXAMPLE_INDEX=0
    for EXAMPLE_EXECUTABLE in "$LAUNCHER_DIRECTORY"/Foundation_*; do
        [ -f "$EXAMPLE_EXECUTABLE" ] || continue
        [ -x "$EXAMPLE_EXECUTABLE" ] || continue
        EXAMPLE_INDEX=$((EXAMPLE_INDEX + 1))
        printf '  %s) %s\n' "$EXAMPLE_INDEX" "${EXAMPLE_EXECUTABLE##*/}"
    done
}

foundation_run_example() {
    REQUESTED_INDEX=$1
    EXAMPLE_INDEX=0
    for EXAMPLE_EXECUTABLE in "$LAUNCHER_DIRECTORY"/Foundation_*; do
        [ -f "$EXAMPLE_EXECUTABLE" ] || continue
        [ -x "$EXAMPLE_EXECUTABLE" ] || continue
        EXAMPLE_INDEX=$((EXAMPLE_INDEX + 1))
        [ "$EXAMPLE_INDEX" -ne "$REQUESTED_INDEX" ] || break
    done

    printf '\nRunning %s...\n\n' "${EXAMPLE_EXECUTABLE##*/}"
    "$EXAMPLE_EXECUTABLE"
    EXAMPLE_STATUS=$?
    printf '\n----------------------------------------\n'
    printf 'Process finished with exit code %s\n' "$EXAMPLE_STATUS"
}

while :; do
    if [ -t 1 ] && command -v clear >/dev/null 2>&1; then
        clear
    fi

    foundation_example_count
    printf 'Foundation Examples\n'
    printf '===================\n\n'

    if [ "$EXAMPLE_COUNT" -eq 0 ]; then
        printf 'No executable examples were found in:\n%s\n' "$LAUNCHER_DIRECTORY" >&2
        printf '\nPress Enter to finish...'
        read -r _
        exit 1
    fi

    foundation_print_menu
    printf '\nSelect an example [1-%s] or q to quit: ' "$EXAMPLE_COUNT"
    IFS= read -r EXAMPLE_SELECTION || exit 0

    case "$EXAMPLE_SELECTION" in
        q|Q)
            exit 0
            ;;
        ''|*[!0-9]*)
            printf '\nInvalid selection. Press Enter to return to the menu...'
            read -r _
            continue
            ;;
    esac

    if [ "$EXAMPLE_SELECTION" -lt 1 ] || [ "$EXAMPLE_SELECTION" -gt "$EXAMPLE_COUNT" ]; then
        printf '\nInvalid selection. Press Enter to return to the menu...'
        read -r _
        continue
    fi

    foundation_run_example "$EXAMPLE_SELECTION"
    printf '\nPress Enter to return to the menu...'
    read -r _
done
